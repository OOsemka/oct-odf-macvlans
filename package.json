{
  "name": "oct-odf-macvlans",
  "version": "0.1.0",
  "description": "Community project. ODF Macvlans Console plugin: move ODF (Ceph) traffic onto dedicated macvlan public/cluster networks. Not officially supported by Red Hat.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve",
    "ts-check": "tsc --noEmit",
    "webpack": "webpack --config webpack.config.js",
    "test": "rm -rf build-test && tsc -p tsconfig.test.json && node --test build-test/"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.21.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.21.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "@patternfly/react-table": "^6.0.0",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.0",
    "css-loader": "^6.10.0",
    "i18next": "^21.10.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-router": "5.3.4",
    "react-router-dom": "^5.3.4",
    "react-router-dom-v5-compat": "^6.30.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "consolePlugin": {
    "name": "oct-odf-macvlans",
    "version": "0.1.0",
    "displayName": "ODF Macvlans",
    "description": "Community project. Create macvlan public/cluster networks for OpenShift Data Foundation and switch the StorageCluster to Multus. Not officially supported by Red Hat.",
    "exposedModules": {
      "OdfMacvlansPage": "./components/OdfMacvlansPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "packageManager": "yarn@4.17.1"
}
